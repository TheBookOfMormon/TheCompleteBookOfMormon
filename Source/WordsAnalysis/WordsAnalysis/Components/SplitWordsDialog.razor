@implements IDialogContentComponent<SplitWordsDialogContent>

<FluentDialogHeader>
    Split text into words - @Content.Edition.BookInfo.Year @Content.Edition.BookInfo.Name
</FluentDialogHeader>

<FluentSelect Autofocus TOption="KeyValuePair<int, SplitWordSuggestion>" Items=@Data OptionValue=@(x => x.Key.ToString()) OptionText=GetOptionText @bind-SelectedOption=SelectedSuggestion />

<FluentDialogFooter>
    <FluentButton Appearance=@Appearance.Accent OnClick=@(() => ConfirmAsync()) accesskey="O">
        <span class="underline">O</span>K
    </FluentButton>
    <FluentButton OnClick=@(() => CancelAsync()) accesskey="C">
        <span class="underline">C</span>ancel
    </FluentButton>
</FluentDialogFooter>