@page "/SyncDocuments"
@using DocumentsModel
@using WordsAnalysis.AppLayer.Features.SyncDocuments
@inject IConfirmService ConfirmService
@inject IDialogService DialogService
@inject IDictionaryService DictionaryService

@if (ViewModel != null)
{
    <PageHeader Href="/" Text="Sync documents">
        <IconPanel Icon=Icons.Filled.Size24.Globe Name="File">
            <IconPanelButton Icon=Icons.Filled.Size24.Save
                             Tooltip="Save changes (Alt S)"
                             Enabled=@ViewModel.IsDirty
                             AccessKey="S"
                             OnClick=@SaveChangesAsync />
            <IconPanelButton Icon=Icons.Filled.Size24.ArrowUndo
                             Tooltip=@(ViewModel.UndoActionDescription + " (Alt Z)")
                             Enabled=@ViewModel.CanUndo
                             AccessKey="Z"
                             OnClick=@ViewModel.UndoAsync />
            <IconPanelButton Icon=Icons.Filled.Size24.ArrowRedo
                             Tooltip=@(ViewModel.RedoActionDescription + " (Alt Y)")
                             Enabled=@ViewModel.CanRedo
                             AccessKey="Y"
                             OnClick=@ViewModel.RedoAsync />
            <label for="section-selector" accesskey="P">Section</label>
            <select @ref=SectionNumberElement id="section-selector" @onchange=SelectedSectionIndexChanged>
                @for (int sectionIndex = 0; sectionIndex < ViewModel.SectionCount; sectionIndex++)
                {
                    bool selected = (sectionIndex == ViewModel.SectionIndex);
                    <option value=@sectionIndex selected=@selected>@(sectionIndex + 1)</option>
                }
            </select>
            <IconPanelButton Icon=Icons.Filled.Size24.ScanText
                             Tooltip="Rescan an area of the page"
                             Enabled=ViewModel.CanRescanArea
                             OnClick=@ViewModel.RescanAreaAsync />
            <IconPanelButton Icon=Icons.Filled.Size24.CopySelect
                             Tooltip="Deselect all"
                             Enabled=@ViewModel.HasSelectedWords
                             OnClick=@ViewModel.DeselectAll />
            <IconPanelButton Icon=Icons.Filled.Size24.AlignLeft
                             Tooltip="Align words (Alt L)"
                             Enabled=@ViewModel.CanAlignSelectedWords
                             AccessKey="L"
                             OnClick=@ViewModel.AlignSelectedWordsAsync />
            <IconPanelButton Icon=Icons.Filled.Size24.ChannelSubtract
                             Tooltip="Delete section (ALT X)"
                             AccessKey="X"
                             Enabled=ViewModel.CanNukeTheRestOfThePage
                             OnClick=@ViewModel.NukeTheRestOfThePageAsync />
            @if (!IsSearchingForNextError)
            {
                <IconPanelButton Icon=Icons.Filled.Size24.AlertUrgent
                                 Tooltip="Next discrepancy (Alt N)"
                                 AccessKey="N"
                                 Enabled=@(!Loading && SelectedEditions.Count > 0)
                                 OnClick=@ScrollToNextWarningOrErrorAsync />
            }
            else
            {
                <IconPanelButton Icon=Icons.Filled.Size24.RecordStop
                                 Tooltip="Stop searching"
                                 OnClick=@StopSearchingForNextError />
            }
            <FluentCheckbox @bind-Value=ViewModel.ShowBenefitOfDoubt @bind-Value:after=ViewModel.ReloadRowDataAsync Label="BOD" />
            @if (ViewModel.HasSelectedWords)
            {
                <span style="margin-left: 1rem">@ViewModel.SelectedWords.Count selected word(s)</span>
            }

        </IconPanel>
        <div style="display:none">
            <button accesskey="a" @onclick=@(() => ViewModel.AddWordAsync()) style="display:none;" />
            <button accesskey="e" @onclick=@(() => ViewModel.EditWordAsync()) style="display:none;" />
            <button accesskey="r" @onclick=@(() => ViewModel.ShowColumnImagesAsync()) style="display:none;" />
            <button accesskey="i" @onclick=@(() => ViewModel.InsertNullWordAsync()) style="display:none;" />
            <button accesskey="d" @onclick=@(() => ViewModel.DeleteSelectedWordsAsync()) style="display:none;" />
            <button accesskey="m" @onclick=@(() => ViewModel.MergeSelectedWordsAsync()) style="display:none;" />
            <button accesskey="x" @onclick=@(() => ViewModel.SuggestSplitWordsAsync()) style="display:none;" />
            <button accesskey="c" @onclick=@(() => ViewModel.SelectColumnAsync()) style="display:none;" />
            <button accesskey="f" @onclick=@(() => ViewModel.MarkSelectedWordsAsEditorialFormattingChangesAsync()) style="display:none;" />
        </div>
    </PageHeader>

    <table class="word-table">
        <thead>
            <tr>
                <th class="word-table_first-cell">&nbsp;</th>
                @{
                    var mostWordsInSection = ViewModel.RowData.Max(x => x.Words.Count);
                    for (int index = 0; index < mostWordsInSection; index++)
                    {
                        <th class="word-table_word-index @GetWordIndexClass(index)">
                            <div class="word-table_word-index-number">
                                @(index + 1)
                            </div>
                        </th>
                    }
                    <th style="min-width:100vw" />
                }
            </tr>
        </thead>
        <tbody>
            @for (int rowIndex = 0; rowIndex < ViewModel.RowData.Length; rowIndex++)
            {
                string? previousDisplayText = "###";
                RowData rowData = ViewModel.RowData[rowIndex];
                EditionState editionState = ViewModel.Editions[rowData.BookInfo];
                <tr @key=rowData.BookInfo.Code>
                    <th class="word-table_edition @GetEditionClass(rowData.BookInfo)" @onclick=@(() => ToggleEditionSelected(rowData.BookInfo))>
                        @rowData.BookInfo.Year&nbsp;@rowData.BookInfo.ShortCode
                    </th>
                    @for (int i = 0; i < rowData.Words.Count; i++)
                    {
                        int columnIndex = i;
                        WordReference wordReference = rowData.Words[columnIndex];
                        OcrWord? word = wordReference.GetWord(editionState);
                        string? displayText = word?.GetDisplayText(ViewModel.ShowBenefitOfDoubt);
                        bool isAlignmentSpacer = displayText == null;
                        <td @key=i id=@wordReference.GetGlobalReference() data-row=@rowIndex data-column=@columnIndex data-text="@displayText">
                            <div class="word-table_word-container @GetWordClass(wordReference, displayText, columnIndex)">
                                <div class="word-table_word" title=@GetWordHint(wordReference) @onclick=@(e => WordClicked(e, wordReference))>
                                    @{
                                        if (!string.IsNullOrEmpty(displayText))
                                        {
                                            <text>@displayText</text>
                                        }
                                        else
                                        {
                                            <text>&nbsp;</text>
                                        }
                                    }
                                </div>
                                <div class="word-table_word-markers">
                                    @if (!string.IsNullOrEmpty(previousDisplayText) && previousDisplayText == displayText)
                                    {
                                        <div title="Duplicate word">+</div>
                                    }
                                    @if (word?.BenefitOfDoubt == BenefitOfDoubt.InkError)
                                    {
                                        <div title="Ink error">I</div>
                                    }
                                    @if (word?.BenefitOfDoubt == BenefitOfDoubt.PrinterError)
                                    {
                                        <div title="Printer error">P</div>
                                    }
                                    @if (word?.BenefitOfDoubt == BenefitOfDoubt.EditorialFormatting)
                                    {
                                        <div title="Editorial formatting">F</div>
                                    }
                                </div>
                            </div>
                        </td>
                        previousDisplayText = displayText;
                    }
                </tr>
            }
        </tbody>
    </table>
}
<FluentOverlay Visible=@(Loading && ShowLoadingIndicator)
               Transparent=@false
               FullScreen
               Opacity="0.4"
               BackgroundColor="#000000"
               Alignment=@Align.Center
               Justification=@JustifyContent.Center>
    <div style="padding: 5rem 10rem; border-radius: 1rem; display:flex; justify-content: center; align-items: center; background-color: var(--neutral-fill-layer-rest);">
        <FluentProgressRing Style="margin-right: 1rem" />Loading...
    </div>
</FluentOverlay>