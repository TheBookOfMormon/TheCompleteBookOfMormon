@page "/Reports"
@using WordsAnalysis.AppLayer.Features.Reports
<PageHeader Href="/" Text="Reports" Disabled=@(EditionProcessor?.StopProcessingEnabled ?? false) />
@if (ViewModel.CurrentState == ReportsViewModel.ReportsState.Loading)
{
    <h2>Loading...</h2>
    <EditionProcessor @ref=EditionProcessor Processor=@ViewModel.Loader HideControlButtons OnFinished=@ViewModel.LoadingFinishedAsync />
}
@if (ViewModel.CurrentState == ReportsViewModel.ReportsState.DeterminingHierarchy)
{
    <h2>Determining hierarchy</h2>
}
@if (ViewModel.CurrentState == ReportsViewModel.ReportsState.DetectingChanges)
{
    <h2>Detecting changes</h2>
    @if (ViewModel.DetectChangesStatus != null)
    {
        <h3>@ViewModel.DetectChangesStatus</h3>
    }
}
@if (ViewModel.SimilarityTableData != null)
{
    <div class="card">
        <h3>Similarity table</h3>
        <EditionSimilarityTable Data=@ViewModel.SimilarityTableData />
    </div>
}
@if (ViewModel.HierarchyData != null)
{
    <div class="card">
        <h3>Hierarchy tree</h3>
        <EditionHierarchyTree Data=@ViewModel.HierarchyData/>
    </div>
}
