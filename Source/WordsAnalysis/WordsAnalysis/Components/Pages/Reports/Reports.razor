@page "/Reports"
<PageHeader Href="/" Text="Reports" Disabled=@(EditionProcessor?.StopProcessingEnabled ?? false) />
@if (CurrentState == State.Loading)
{
    <h2>Loading...</h2>
    <EditionProcessor @ref=EditionProcessor Processor=@Loader HideControlButtons OnFinished=@LoadingFinishedAsync />
}
@if (CurrentState == State.DeterminingHierarchy)
{
    <h2>Determining hierarchy</h2>
}
@if (CurrentState == State.DetectingChanges)
{
    <h2>Detecting changes</h2>
    @if (DetectChangesStatus != null)
    {
        <h3>@DetectChangesStatus</h3>
    }
}
@if (SimilarityTableData != null)
{
    <div class="card">
        <h3>Similarity table</h3>
        <EditionSimilarityTable Data=@SimilarityTableData />
    </div>
}
@if (HierarchyData != null)
{
    <div class="card">
        <h3>Hierarchy tree</h3>
        <EditionHierarchyTree Data=@HierarchyData/>
    </div>
}
