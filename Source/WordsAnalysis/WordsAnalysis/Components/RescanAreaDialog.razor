@using WordsAnalysis.AppLayer.Features.SyncDocuments
@implements IDialogContentComponent<RescanAreaDialog.RescanAreaDialogContent>
@inject IImageRepository ImageRepository

<FluentDialogHeader>
    Rescan area - @Content.Edition.BookInfo.Year @Content.Edition.BookInfo.Name
</FluentDialogHeader>

<FluentDialogBody>
    <div style="display: flex; flex-direction: row; align-items: flex-start;">
        <div style="position:relative; flex-grow: 1;  overflow: auto;">
            <HighlightBox @bind-Rect=Bounds />
            <img src=@PageImageData style="flex-grow: 1; flex-shrink: 1;" />
        </div>
        <div style="display: flex; flex-direction: column; align-items: flex-end; align-self: flex-start;">
            <FluentToolbar>
                <RepeatingFluentButton IconStart=@SharedIcons.ArrowUp OnClick=@(e => MoveUp(e)) />
                <RepeatingFluentButton IconStart=@SharedIcons.ArrowDown OnClick=@(e => MoveDown(e)) />
                <RepeatingFluentButton IconStart=@SharedIcons.ArrowLeft OnClick=@(e => MoveLeft(e)) />
                <RepeatingFluentButton IconStart=@SharedIcons.ArrowRight OnClick=@(e => MoveRight(e)) />
            </FluentToolbar>
            <InputTextArea @bind-Value=ScannedText readonly rows="10" />
        </div>
    </div>
</FluentDialogBody>

<FluentDialogFooter>
    <FluentButton Appearance=@Appearance.Accent OnClick=@(() => Rescan()) accesskey="S">
        Re<span class="underline">s</span>can
    </FluentButton>
    <FluentButton Appearance=@Appearance.Accent OnClick=@(() => ConfirmAsync()) accesskey="O">
        <span class="underline">O</span>K
    </FluentButton>
    <FluentButton OnClick=@(() => CancelAsync()) accesskey="C">
        <span class="underline">C</span>ancel
    </FluentButton>
</FluentDialogFooter>