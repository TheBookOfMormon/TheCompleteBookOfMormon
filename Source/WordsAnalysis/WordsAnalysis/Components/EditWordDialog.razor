@using WordsAnalysis.AppLayer.Features.SyncDocuments
@using DocumentsModel
@implements IDialogContentComponent<EditWordDialog.EditWordDialogContent>
@inject IDialogService DialogService
@inject IHtmlService HtmlService
@inject IToastService ToastService
@inject IImageRepository ImageRepository

<FluentDialogHeader>
    @GetActionName() word - @Content.Edition.BookInfo.Year @Content.Edition.BookInfo.Name
</FluentDialogHeader>

<FluentDialogBody>
    <div style="display: grid; grid-template-columns: 1fr auto; height:100%; gap: 1rem;">

        <div style="grid-column: 1; display: flex; flex-direction: column; max-width: 100%; max-height: 100%; height: 100%; gap: 1rem; overflow: hidden;">

            <!-- Top Image Container (exactly 50%) -->
            <div style="flex: 0 0 25%; overflow: auto;">
                <img id="word-image" src=@WordImageData style="display: block; width: 100%; height:100%; object-fit: contain;" />
            </div>

            <!-- Bottom Image Container (takes remaining 50%) -->
            <div style="flex:1; overflow:auto; position:relative; ">
                @foreach (TextData element in Texts)
                {
                    <HighlightBox @bind-Rect=element.Bounds @bind-Rect:after=UpdateWordImageData />
                }
                <img id="page-image" src=@PageImageData />
            </div>

        </div>

        <EditForm @ref=EditForm Model=@Texts style="grid-column: 2; overflow-x: hidden; overflow-y: auto; padding:0.25rem;">
            <ObjectGraphDataAnnotationsValidator />
            <div class="space-around-container mb-1">
                <FluentCheckbox Label="✗" title="Corrected" @bind-Value=Corrected />
                <FluentCheckbox Label="✓" title="Correction" @bind-Value=Correction />
                <FluentCheckbox Label="^" title="Inserted" @bind-Value=Inserted />
                @if (Texts.Length > 1)
                {
                    <FluentCheckbox Label="-" title="Show dashes" @bind-Value=ShowDashes />
                }

            </div>
            <div class="flex-row-container --justify-content-start">
                <FluentNumberField @bind-Value=LineHeight Min=8 Max=100 Label="Line height" @bind-Value:after=ResetLineHeightAdjustment />
                @if (HasSampleImages)
                {
                    <FluentButton IconStart=@SharedIcons.TextSamples Title="Text samples"  Class="ml-1" OnClick=@ShowTextSamplesAsync />
                }
            </div>

            <div>
                <FluentTextField @bind-Value=Notes Label="Notes" />
                <FluentKeyCode PreventDefaultOnly=[KeyCode.Escape]>
                    <FluentSelect TOption="KeyValuePair<BenefitOfDoubt, string>" Items=@BenefitOfDoubtExtensions.GetOptions() Label="Benefit of doubt" @bind-SelectedOption=BenefitOfDoubtSelectedOption OptionText=@(x => x.Value) OptionValue=@(x => x.Key.ToString()) />
                </FluentKeyCode>
                @if (BenefitOfDoubtSelectedOption.Key != BenefitOfDoubt.None)
                {
                    <FluentTextField @bind-Value=BenefitOfDoubtText Label="Intended text" />
                }
            </div>

            @{
                int index = -1;
                foreach (TextData item in Texts)
                {
                    index++;
                    int capturedIndex = index;
                    bool isReadonly = index == 1 && item.Text == "-";
                    <div>
                        <FluentToolbar>
                            <RepeatingFluentButton IconStart=@SharedIcons.ArrowUp OnClick=@(e => MoveUpAsync(e, capturedIndex)) />
                            <RepeatingFluentButton IconStart=@SharedIcons.ArrowDown OnClick=@(e => MoveDownAsync(e, capturedIndex)) />
                            <RepeatingFluentButton IconStart=@SharedIcons.ArrowLeft OnClick=@(e => MoveLeftAsync(e, capturedIndex)) />
                            <RepeatingFluentButton IconStart=@SharedIcons.ArrowRight OnClick=@(e => MoveRightAsync(e, capturedIndex)) />
                            <RepeatingFluentButton IconStart=@SharedIcons.DropFirstLetter accesskey="f" OnClick=@(e => DropFirstLetter(capturedIndex)) Disabled=@isReadonly />
                            <RepeatingFluentButton IconStart=@SharedIcons.EstimateWordSize OnClick=@(e => EstimateWordSize(capturedIndex)) accesskey="w" />
                            @if (Texts.Length == 1)
                            {
                                <FluentButton OnClick=@ConvertAmpersand accesskey="&">&amp;</FluentButton>
                            }
                        </FluentToolbar>
                    </div>
                    <FluentTextField @bind-Value=item.Text Style="font-family: 'Times New Roman'" readonly=@isReadonly autocomplete="off" Autofocus=@(capturedIndex == 0) @bind-Value:after=ResetLineHeightAdjustment />
                }
            }
            @if (Content.IsAdd)
            {
                <div>
                    <label>
                        Add
                        @if (AddWordAfter)
                        {
                            <text>Before / <em>After</em></text>
                        }
                        else
                        {
                            <text><em>Before</em> / After</text>
                        }
                    </label>
                    <FluentCheckbox @bind-Value=AddWordAfter />&nbsp;
                </div>
            }
            <FluentDivider Style="margin:0.5em 0 1em 0;" />
            <div>
                <FluentCheckbox @bind-Value=ShowHighContrast @bind-Value:after=@PageFilterChanged Label="High contrast" />
                @if (ShowHighContrast)
                {
                    <FluentCheckbox @bind-Value=ApplyThreshold @bind-Value:after=@PageFilterChanged Label="Threshhold" />
                    @if (ApplyThreshold)
                    {
                        <FluentSlider @bind-Value=ThresholdLower @bind-Value:after=@ThresholdLowerChanged Label="Lower" Min=0 Max=99 Step=1 />
                        <FluentSlider @bind-Value=ThresholdUpper @bind-Value:after=@ThresholdUpperChanged Label="Upper" Min=1 Max=100 Step=1 />
                    }
                }
            </div>

        </EditForm>
    </div>
</FluentDialogBody>

<FluentDialogFooter>
    @if (!Content.IsAdd)
    {
        <FluentButton OnClick=@PreviousAsync accesskey="P">
            <span class="underline">P</span>rev
        </FluentButton>
        <FluentButton OnClick=@NextAsync accesskey="N">
            <span class="underline">N</span>ext
        </FluentButton>
    }
    <FluentButton Appearance=@Appearance.Accent OnClick=@(() => ConfirmAsync()) accesskey="O">
        <span class="underline">O</span>K
    </FluentButton>
    <FluentButton OnClick=@(() => CancelAsync()) accesskey="C">
        <span class="underline">C</span>ancel
    </FluentButton>
</FluentDialogFooter>