@inject IJSRuntime JS
<div class="grid" style=@GetStyle() @onmousedown:preventDefault @onmousedown:stopPropagation>
    <div class="cell" @onmousedown=@(e => MouseDownAsync(e, CellPosition.TopLeft)) />
    <div class="cell" @onmousedown=@(e => MouseDownAsync(e, CellPosition.Top)) />
    <div class="cell" @onmousedown=@(e => MouseDownAsync(e, CellPosition.TopRight)) />
    <div class="cell" @onmousedown=@(e => MouseDownAsync(e, CellPosition.Left)) />
    <div class="cell center" @onmousedown=@(e => MouseDownAsync(e, CellPosition.Middle)) />
    <div class="cell" @onmousedown=@(e => MouseDownAsync(e, CellPosition.Right)) />
    <div class="cell" @onmousedown=@(e => MouseDownAsync(e, CellPosition.BottomLeft)) />
    <div class="cell" @onmousedown=@(e => MouseDownAsync(e, CellPosition.Bottom)) />
    <div class="cell" @onmousedown=@(e => MouseDownAsync(e, CellPosition.BottomRight)) />
</div>
