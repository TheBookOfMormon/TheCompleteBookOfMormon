@inject IJSRuntime JS
<div @ref=HighlightBoxElementReference class="highlight-box" style=@GetStyle() @onmousedown:preventDefault @onmousedown:stopPropagation>
    <div class="cell center" @onmousedown=@(e => MouseDownAsync(e, CellPosition.Middle)) />
    <div class="cell grab-handle top-left" @onmousedown=@(e => MouseDownAsync(e, CellPosition.TopLeft)) />
    <div class="cell grab-handle top" @onmousedown=@(e => MouseDownAsync(e, CellPosition.Top)) />
    <div class="cell grab-handle top-right" @onmousedown=@(e => MouseDownAsync(e, CellPosition.TopRight)) />
    <div class="cell grab-handle left" @onmousedown=@(e => MouseDownAsync(e, CellPosition.Left)) />
    <div class="cell grab-handle right" @onmousedown=@(e => MouseDownAsync(e, CellPosition.Right)) />
    <div class="cell grab-handle bottom-left" @onmousedown=@(e => MouseDownAsync(e, CellPosition.BottomLeft)) />
    <div class="cell grab-handle bottom" @onmousedown=@(e => MouseDownAsync(e, CellPosition.Bottom)) />
    <div class="cell grab-handle bottom-right" @onmousedown=@(e => MouseDownAsync(e, CellPosition.BottomRight)) />
</div>
   