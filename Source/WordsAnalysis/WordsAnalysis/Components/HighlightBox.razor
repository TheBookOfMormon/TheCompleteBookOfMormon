@inject IJSRuntime JS
<div class="grid" style=@GetStyle() @onmousedown:preventDefault @onmousedown:stopPropagation>
    <div class="cell center" @onmousedown=@(e => MouseDownAsync(e, CellPosition.Middle)) />
    <div class="cell top-left" @onmousedown=@(e => MouseDownAsync(e, CellPosition.TopLeft)) />
    <div class="cell top" @onmousedown=@(e => MouseDownAsync(e, CellPosition.Top)) />
    <div class="cell top-right" @onmousedown=@(e => MouseDownAsync(e, CellPosition.TopRight)) />
    <div class="cell left" @onmousedown=@(e => MouseDownAsync(e, CellPosition.Left)) />
    <div class="cell right" @onmousedown=@(e => MouseDownAsync(e, CellPosition.Right)) />
    <div class="cell bottom-left" @onmousedown=@(e => MouseDownAsync(e, CellPosition.BottomLeft)) />
    <div class="cell bottom" @onmousedown=@(e => MouseDownAsync(e, CellPosition.Bottom)) />
    <div class="cell bottom-right" @onmousedown=@(e => MouseDownAsync(e, CellPosition.BottomRight)) />
</div>
   