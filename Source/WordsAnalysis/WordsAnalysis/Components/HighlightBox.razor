<div class="grid" style="left:@(X)px; top:@(Y)px; width:@(Width)px; height:@(Height)px;">
    <div class="cell">&nbsp;</div>  <!-- top-left -->
    <div class="cell">&nbsp;</div>  <!-- top-middle -->
    <div class="cell">&nbsp;</div>  <!-- top-right -->
    <div class="cell">&nbsp;</div>  <!-- middle-left -->
    <div class="cell center">&nbsp;</div> <!-- center -->
    <div class="cell">&nbsp;</div>  <!-- middle-right -->
    <div class="cell">&nbsp;</div>  <!-- bottom-left -->
    <div class="cell">&nbsp;</div>  <!-- bottom-middle -->
    <div class="cell">&nbsp;</div>  <!-- bottom-right -->
</div>
